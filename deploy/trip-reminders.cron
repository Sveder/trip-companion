# Trip Companion reminder emails and the daily guest cleanup (T232). Install: sudo cp deploy/trip-reminders.cron /etc/cron.d/trip-reminders
0 14,15 * * * server /srv/www/trip-companion/deploy/send_reminders.sh >> /srv/www/trip-companion/reminders.log 2>&1
10 4 * * * server /srv/www/trip-companion/deploy/delete_empty_guests.sh >> /srv/www/trip-companion/cleanup.log 2>&1
